<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:text="Recordatorios"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"/>

    <TextView
        android:id="@+id/tvReminderStatus"
        android:text="Sin recordatorios activos"
        android:textSize="16sp"
        android:textColor="#F57C00"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnScheduleReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Programar recordatorio"
        android:backgroundTint="#1565C0"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnCancelReminder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cancelar recordatorio"
        android:backgroundTint="#E53935"/>

</LinearLayout>